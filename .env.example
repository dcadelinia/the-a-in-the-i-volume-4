# ==============================================================================
# PROJECT KORIDOR ENVIRONMENT CONFIGURATION TEMPLATE
# ODYNEX AXIS LOGISTICS LLC - PROPRIETARY INTELLECTUAL PROPERTY
# ==============================================================================
# INSTRUCTIONS: Copy this file to '.env' and populate with production values.
# DO NOT commit your live '.env' file containing active secret keys to GitHub.

# SYSTEM OPERATION ENVIRONMENT [PRODUCTION / TESTING / STAGING]
ODYNEX_ENV=PRODUCTION
SYSTEM_LOG_LEVEL=INFO

# INTELLECTUAL PROPERTY SECURITY KEYS (TRIPS AGREEMENT COMPLIANT)
# Provided exclusively under commercial licensing agreements by Odynex Axis
ODYNEX_GLOBAL_LICENSE_KEY=ody_live_your_secured_enterprise_key_here
SECURITY_WATERMARK_SEED=6f64796e65785f617869735f6c6f67697374696373

# NATIVE HARDWARE ACCELERATION BOUNDARIES (NVIDIA JETSON ECOSYSTEM)
# Set to 'True' to activate CuPy vectorization arrays and TensorRT camera streams
USE_NVIDIA_CUDA_ACCELERATION=True
TENSORRT_MODEL_ENGINE_PATH=models/daa_yolov10_fp16.engine

# REGIONAL AGRI-GEOSPATIAL ROUTING CORRIDOR BASES
# Default metrics configured for SOWEGA (Southwest Georgia Regional coordinates)
REGIONAL_DEFAULT_LATITUDE=31.5785
REGIONAL_DEFAULT_LONGITUDE=-84.1557
AIRSPACE_SAFETY_BUFFER_METERS=30.0

# HARDWARE TELEMETRY & NETWORK GATEWAYS
# IP arrays or communication ports connecting to local co-op RTK GPS stations
RTK_BASE_STATION_BROKER_URL=mqtt://localhost:1883
DRONE_AUTOPILOT_MAVLINK_PORT=14550
